{
  "_readme": "This file controls EVERYTHING the daily fetcher does. You can edit it on github.com (click the pencil icon) without touching any code. JSON rules: keep the double quotes, and put a comma between items but NOT after the last item in a list.",

  "edition": {
    "name": "The Morning Ledger",
    "tagline": "A quiet read for a busy morning",
    "timezone": "Asia/Kolkata"
  },

  "limits": {
    "_note": "scan_per_feed = how many newest entries to look at per feed. per_feed = max stories kept from one feed. per_section = max stories in a section. summary_words = excerpt length. min_full_words = a 'full text' item must have at least this many words.",
    "max_age_hours": 48,
    "scan_per_feed": 15,
    "per_feed": 3,
    "per_section": 8,
    "summary_words": 45,
    "min_full_words": 150,
    "retention_days": 30
  },

  "markets": {
    "_note": "All three sources are free and need no API key. Stooq = index quotes. Frankfurter = European Central Bank reference exchange rates. CoinGecko = crypto prices. Remove a block to hide it. To add an index, add its Stooq symbol (see stooq.com).",
    "indices": [
      { "symbol": "^spx", "label": "S&P 500" },
      { "symbol": "^dji", "label": "Dow Jones" },
      { "symbol": "^ndq", "label": "Nasdaq" },
      { "symbol": "^ukx", "label": "FTSE 100" },
      { "symbol": "^dax", "label": "DAX" },
      { "symbol": "^nkx", "label": "Nikkei 225" }
    ],
    "fx": { "base": "USD", "symbols": ["INR", "EUR", "GBP", "JPY"] },
    "crypto": { "ids": ["bitcoin", "ethereum"], "vs": "usd" }
  },

